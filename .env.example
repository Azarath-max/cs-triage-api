# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cs_automation

# Leave empty to run in stub mode (deterministic classification, no external calls).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# When set, every request to /v1/messages must send this value in X-Webhook-Secret.
WEBHOOK_SECRET=

# Routing thresholds.
MIN_CONFIDENCE=0.70
AUTO_SEND_CONFIDENCE=0.80

# Safety valve: all outgoing mail goes here instead of the real customer.
TEST_RECIPIENT=
